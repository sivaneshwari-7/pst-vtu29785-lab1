import java.io.*;
import java.util.*;
public class Solution {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int t = s.nextInt();
        HashSet<String> pairs = new HashSet<>(t);
        for (int i = 0; i < t; i++) {
            String pair = s.next() + " " + s.next();
            pairs.add(pair);
            System.out.println(pairs.size());
        }
        s.close();
    }
}
